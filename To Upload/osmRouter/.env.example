# ============================================================================
# osmRouter Production Environment
# ----------------------------------------------------------------------------
# Copy this file to `.env` and replace EVERY placeholder marked with «CHANGE».
# Generate cryptographic secrets with: ./scripts/generate-secrets.sh
# ============================================================================

# ----- 1. Domain & deployment surface ----------------------------------------
# The root brand domain. Used to build cookie domain, CORS origin, and the
# CNAME target your customers will point their domains at.
OSM_BRAND_DOMAIN=osmrouter.com

# The hostname customers add as a CNAME to bring their own domain.
# Must be public-resolvable and routed to your proxy node(s).
OSM_PROXY_CNAME=nodes.osmrouter.com

# Comma-separated list of fully-qualified origins the dashboard runs from.
# These are the ONLY origins allowed to send cookies to the API.
OSM_CORS_ORIGINS=https://osmrouter.com,https://app.osmrouter.com,https://www.osmrouter.com

# Sent on every Set-Cookie. Leading dot means cookies are shared across
# sub-domains of osmrouter.com.
OSM_COOKIE_DOMAIN=.osmrouter.com

# MUST be true in production. Cookies will only be sent over HTTPS.
OSM_COOKIE_SECURE=true

# Set to `prod`. Disables all dev affordances (no OTP echo, secret-required, …)
OSM_ENV=prod


# ----- 2. Cryptographic secrets (generate fresh!) ---------------------------
# Each MUST be a fresh 32-byte cryptographically random value.
# Generate all five at once:    ./scripts/generate-secrets.sh
# Or individually:              openssl rand -hex 32

OSM_JWT_SECRET=«CHANGE»                  # JWT HS256 signing key
OSM_OTP_MASTER_SECRET=«CHANGE»           # HMAC key for email-OTP + domain-verify token
OSM_CSRF_SECRET=«CHANGE»                 # CSRF token derivation
OSM_AES_MASTER_KEY=«CHANGE»              # AES-256-GCM master key for at-rest encryption
OSM_PROXY_NODE_SECRET=«CHANGE»           # Bearer secret proxy nodes use to call the control plane


# ----- 3. PostgreSQL ---------------------------------------------------------
# Use a managed Postgres in production (RDS, Neon, Supabase, Cloud SQL).
# If you self-host, make sure backups + PITR are configured.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=osm
POSTGRES_USER=osm
POSTGRES_PASSWORD=«CHANGE»               # strong random; never reuse a dev password

# Composed automatically — leave as-is unless using an external DB host.
OSM_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=require


# ----- 4. Redis --------------------------------------------------------------
# Used as the live-mapping cache that proxy nodes read on every request.
# Use Redis 7+ with persistence (RDB or AOF) so the cache survives restarts.
REDIS_PASSWORD=«CHANGE»
OSM_REDIS_URL=redis://default:${REDIS_PASSWORD}@redis:6379


# ----- 5. Rate limits (override defaults if needed) -------------------------
OSM_RL_AUTH=5                            # auth-route requests per minute per IP
OSM_RL_NORMAL=100                        # normal-route requests per minute per user


# ----- 6. Email (OTP delivery) — REQUIRED in production ---------------------
# osmRouter currently does NOT ship an SMTP sender. The OTP code must reach
# the user via some mechanism. Pick ONE of:
#
#   (a)  Wire SMTP in server/internal/auth/service.go and set the four vars
#        below. (Recommended.)
#   (b)  Wire a transactional-mail API (SendGrid, Postmark, Resend) and
#        replace the email-send call in service.go with the API client.
#   (c)  Run with OSM_DEV_EXPOSE_OTP=true — NOT RECOMMENDED, leaks OTPs in
#        the registration HTTP response. Only acceptable for closed internal
#        instances behind a trusted authentication proxy.
#
# The flag below is a hard refusal in `OSM_ENV=prod` unless you've explicitly
# opted in.
OSM_DEV_EXPOSE_OTP=false

# SMTP, if you go with option (a):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@osmrouter.com


# ----- 7. Cloudflare-for-SaaS (optional but recommended) --------------------
# Auto-provisions SSL for the custom domains your users attach. Without this
# you'll need to issue certificates manually (or run behind a Caddy / nginx
# that does ACME on demand).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CUSTOM_HOSTNAMES_FALLBACK_ORIGIN=


# ----- 8. Billing (Stripe) — only if/when monetised --------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=


# ----- 9. Observability (recommended) ---------------------------------------
# Forward structured JSON logs from stdout to your log aggregator.
# Set these only if you've decided on a provider:
SENTRY_DSN=
PROMETHEUS_METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=


# ----- 10. Per-proxy-node settings (set on each proxy host) -----------------
# Only used by the proxy-node container — not the control plane.
# If you run multiple proxy nodes, each needs a unique NODE_ID.
OSM_NODE_ID=node-prod-01
OSM_PUBLIC_ADDR=:8000
OSM_TUNNEL_ADDR=:8001
OSM_CONTROL_PLANE_URL=https://api.osmrouter.com


# ----- 11. Public dashboard config (build-time variable for Next.js) --------
NEXT_PUBLIC_API_BASE=https://api.osmrouter.com

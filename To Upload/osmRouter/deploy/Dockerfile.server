# osmRouter Control Plane — production Dockerfile.
# Build context: the project root.
FROM golang:1.24-alpine AS builder
ENV GOTOOLCHAIN=auto
# CGO is required by go-sqlite3 (only for SQLite mode; pgx for Postgres also works without it).
RUN apk add --no-cache gcc musl-dev sqlite-dev
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates sqlite-libs tzdata && \
    addgroup -S osm && adduser -S osm -G osm
WORKDIR /app
COPY --from=builder /out/api /app/api
RUN mkdir -p /data && chown osm:osm /data
USER osm
EXPOSE 8080
ENTRYPOINT ["/app/api"]

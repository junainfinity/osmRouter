# osmRouter Data Plane proxy node — production Dockerfile.
# Build context: the project root.
FROM golang:1.24-alpine AS builder
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY proxy-node/go.mod proxy-node/go.sum ./
RUN go mod download
COPY proxy-node/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/proxy ./cmd/proxy

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S osm && adduser -S osm -G osm
WORKDIR /app
COPY --from=builder /out/proxy /app/proxy
USER osm
EXPOSE 8000 8001
ENTRYPOINT ["/app/proxy"]

# osmRouter Dashboard (Next.js 16) — production Dockerfile.
# Build context: the project root.
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml* web/package-lock.json* web/yarn.lock* ./
# pnpm 10 treats post-install warnings on optional deps (sharp / unrs-resolver)
# as hard errors; --ignore-scripts skips those hooks. Next.js falls back to JS.
RUN corepack enable && pnpm install --ignore-scripts

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
ARG NEXT_PUBLIC_API_BASE
ENV NEXT_TELEMETRY_DISABLED=1 CI=true NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
RUN node_modules/.bin/next build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S osm && adduser -S osm -G osm
COPY --from=builder --chown=osm:osm /app ./
USER osm
EXPOSE 3000
CMD ["sh", "-c", "node_modules/.bin/next start -p 3000 -H 0.0.0.0"]

# Build + run the Fumadocs site at docs.osmrouter.com. Build context: root.
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY docs/package.json docs/pnpm-lock.yaml* ./
# Same flag as Dockerfile.web — see that file for why.
RUN corepack enable && pnpm install --ignore-scripts

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY docs/ ./
ENV NEXT_TELEMETRY_DISABLED=1 CI=true
# fumadocs-mdx normally runs via `postinstall`; --ignore-scripts skipped it.
# Run it manually so the .source/ manifest exists before `next build`.
RUN node_modules/.bin/fumadocs-mdx
RUN node_modules/.bin/next build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001 \
    HOSTNAME=0.0.0.0
RUN addgroup -S osm && adduser -S osm -G osm
COPY --from=builder --chown=osm:osm /app ./
USER osm
EXPOSE 3001
CMD ["sh", "-c", "node_modules/.bin/next start -p 3001 -H 0.0.0.0"]

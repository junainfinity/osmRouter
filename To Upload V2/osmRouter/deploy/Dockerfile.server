# Build + run the osmRouter Control Plane (Go API server).
# Build context: the project root.
FROM golang:1.24-alpine AS builder
ENV GOTOOLCHAIN=auto
# CGO is required because go-sqlite3 ships C code. gcc + musl-dev provide
# the host toolchain.
RUN apk add --no-cache gcc musl-dev sqlite-dev
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates sqlite-libs sqlite && \
    addgroup -S osm && adduser -S osm -G osm
WORKDIR /app
COPY --from=builder /out/api /app/api
RUN mkdir -p /data && chown osm:osm /data
USER osm
EXPOSE 8080
ENV OSM_ENV=dev \
    OSM_HTTP_ADDR=:8080 \
    OSM_DATABASE_URL=sqlite:///data/osm.db
ENTRYPOINT ["/app/api"]
